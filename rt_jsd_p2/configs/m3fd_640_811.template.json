    },
    "ranking": {
      "beta": 0.1,
      "start_epoch": 3.0,
      "ramp_epochs": 5.0,
      "class_ids": [
        0,
        3,
        4
      ],
      "modality": "rgb",
      "normalization": "mean_images_sum_per_gt_hinge_over_all_gt_count",
      "quality": "detached ordinary IoU",
      "confidence": "objectness times GT-class probability",
      "class_weighting": "uniform per GT"
