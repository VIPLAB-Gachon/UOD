        "linear_schedule_lrf.01",
        "warmup3",
        "existingpaired_flip_scale_translate",
        "EMA_validation",
        "Soft_NMS"
      ]
    },
    "common_protocol": "configs/protocol.json",
    "split_seed": 2026,
    "training_seed": 2026,
    "method": "final_rt_jsd_sc_vfl",
    "runtime_shared_with": null,
